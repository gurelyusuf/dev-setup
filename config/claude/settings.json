{
  "permissions": {
    "allow": [
      "Bash(docker start:*)",
      "Bash(brew list:*)",
      "Bash(npx tsc:*)",
      "Bash(xargs basename:*)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Read(//private/tmp/**)",
      "Bash(xargs ls *)",
      "Read(//opt/homebrew/**)",
      "Bash(npx jest *)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws sso login*)",
      "Bash(aws configure list*)",
      "Bash(aws logs tail *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws logs describe-*)",
      "Bash(aws logs get-*)",
      "Bash(aws ssm describe-*)",
      "Bash(aws ssm list-*)",
      "Bash(aws cloudfront get-*)",
      "Bash(aws cloudfront list-*)",
      "Bash(aws wafv2 get-*)",
      "Bash(aws wafv2 list-*)",
      "Bash(aws route53 get-*)",
      "Bash(aws route53 list-*)",
      "Bash(aws sesv2 get-*)",
      "Bash(aws sesv2 list-*)",
      "Bash(aws ses get-*)",
      "Bash(aws ses list-*)",
      "mcp__plugin_context-mode_context-mode",
      "mcp__context7"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.secrets)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "ponytail-bar@dev-setup": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "dev-setup": {
      "source": {
        "source": "github",
        "repo": "gurelyusuf/dev-setup"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": false
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
